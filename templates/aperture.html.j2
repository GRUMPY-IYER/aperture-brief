{#- The Aperture — page template.
    Content comes from content/{date}.json. Layout/wording lives HERE only. -#}
{#- The save control. Carries the story's own details so the saved panel can
    render an entry without re-reading the page it came from. -#}
{%- macro save_btn(it, section) %}<button type="button" class="save" aria-pressed="false"
            data-url="{{ it.url }}" data-headline="{{ it.headline }}"
            data-source="{{ it.source }}" data-section="{{ section }}"
            aria-label="Add to read later"><svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"
            ><path d="M3.5 1.5h9v13l-4.5-3.5-4.5 3.5z" fill="none" stroke="currentColor"
            stroke-width="1.6" stroke-linejoin="round"/></svg></button>
{%- endmacro %}
{%- macro item_top(it, lede=false, section='') %}
        <div class="top-item{% if lede %} lede{% endif %}">
          <div class="source-row"><div class="source">{{ it.source }}{% if it.investigative %} <span class="investigative-flag">Investigative</span>{% endif %}</div>{{ save_btn(it, section) }}</div>
          <h3><a href="{{ it.url }}" target="_blank">{{ it.headline }}</a></h3>
          <p class="blurb">{{ it.blurb }}</p>
          {%- if it.pm_note %}
          <p class="pm-note"><b>Why it matters for you:</b> {{ it.pm_note }}</p>
          {%- endif %}
        </div>
{%- endmacro %}
{%- macro item_more(it, section='') %}
        <div class="more-item">
          {%- if it.image %}
          <img src="{{ it.image }}" alt="">
          {%- endif %}
          <div class="more-text">
            <div class="source-row"><div class="source">{{ it.source }}{% if it.investigative %} <span class="investigative-flag">Investigative</span>{% endif %}</div>{{ save_btn(it, section) }}</div>
            <h4><a href="{{ it.url }}" target="_blank">{{ it.headline }}</a></h4>
            <p>{{ it.blurb }}</p>
          </div>
        </div>
{%- endmacro %}
{%- macro item_apu(it, section='') %}
          <div class="apu-item">
            {%- if it.image %}
            <img src="{{ it.image }}" alt="">
            {%- endif %}
            <div class="apu-text">
              <div class="source-row"><div class="source">{{ it.source }}</div>{{ save_btn(it, section) }}</div>
              <h4><a href="{{ it.url }}" target="_blank">{{ it.headline }}</a></h4>
              <p>{{ it.blurb }}</p>
            </div>
          </div>
{%- endmacro %}
{#- One photograph, at its true proportions. width/height are the real pixel
    dimensions so the browser reserves the right box before it loads; the CSS
    sizes by width with height:auto, so nothing is ever cropped to fit. -#}
{%- macro photo(pic, cls) %}
        <figure class="{{ cls }}{% if pic.portrait %} portrait{% endif %}">
          <a href="https://grumpyiyer.com" target="_blank" rel="noopener">
            <img src="{{ icon_prefix }}wildlife/{{ pic.file }}" width="{{ pic.w }}" height="{{ pic.h }}"
                 alt="Wildlife photograph by Ganges Bhardwaj" loading="lazy">
          </a>
          <figcaption>From the Field <span>&middot; Grumpy Iyer</span></figcaption>
        </figure>
{%- endmacro %}
{#- The photography desk. Replaces filler photos: the same pictures, given a
    standing section instead of being used to plug a layout hole. -#}
{%- macro showcase_section(names) %}
    <section class="showcase">
      <h2>From the Field <span class="tag">photographs by Ganges Bhardwaj</span></h2>
      <div class="frames">
        {%- for pic in names %}
        <a href="https://grumpyiyer.com" target="_blank" rel="noopener">
          <img src="{{ icon_prefix }}wildlife/{{ pic.file }}" width="{{ pic.w }}" height="{{ pic.h }}"
               alt="Wildlife photograph by Ganges Bhardwaj" loading="lazy">
        </a>
        {%- endfor %}
      </div>
    </section>
{%- endmacro %}
{%- macro primer_box(primers) %}
      <div class="primer-box">
        <h5>Today's Concept, Explained Simply</h5>
        {%- for p in primers %}
        <div class="primer-item">
          <div class="term">{{ p.term }}</div>
          <p>{{ p.text }}</p>
        </div>
        {%- endfor %}
      </div>
{%- endmacro %}
{#- A standard two-column main section. Collapses to one column when there are no more-items. -#}
{#- A main-column section. All stories go in ONE flow container; the browser
    balances the columns. `lede` promotes the first top story to full width. -#}
{#- A main-column section. The lede plus the first few stories are visible;
    the remainder sit behind a native <details> fold so the page stays short
    without losing anything. No JavaScript, so archived editions keep working. -#}
{%- macro section_std(css, title, tag, top, more, lede) %}
{%- set sec = title|striptags %}
{%- set rest = top[1:] if (lede and top) else top %}
{%- set shown = rest[:visible_after_lede] %}
{%- set folded = rest[visible_after_lede:] %}
{%- set folded_more = more %}
    <section class="{{ css }}">
      <h2>{{ title }}{% if tag %} <span class="tag">{{ tag }}</span>{% endif %}</h2>
      <div class="flow">
        {%- if lede and top %}
{{- item_top(top[0], true, sec) }}
        {%- endif %}
        {%- for it in shown %}{{ item_top(it, false, sec) }}{% endfor %}
      </div>
      {%- if folded or folded_more %}
      <details class="fold">
        <summary>{{ (folded|length) + (folded_more|length) }} more in {{ title|striptags }}</summary>
        <div class="flow">
          {%- for it in folded %}{{ item_top(it, false, sec) }}{% endfor %}
          {%- for it in folded_more %}{{ item_more(it, sec) }}{% endfor %}
        </div>
      </details>
      {%- endif %}
    </section>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>The Aperture — {{ date_long }}</title>
<style>
  body {
    font-family: 'Georgia', 'Times New Roman', serif;
    color: #1a1a1a;
    max-width: 1180px;
    margin: 0 auto;
    padding: 32px 24px;
    background: #fdfcf7;
  }
  header { text-align: center; border-bottom: 4px double #1a1a1a; padding-bottom: 14px; margin-bottom: 20px; position: relative; }
  .header-logo { position: absolute; top: 0; left: 0; width: 60px; height: 60px; object-fit: contain; }
  @media (max-width: 520px) { .header-logo { width: 40px; height: 40px; } }
  .masthead { font-size: 46px; font-weight: bold; letter-spacing: 1px; margin: 0; }
  .dateline-row {
    display: flex; justify-content: space-between; font-family: Arial, sans-serif;
    font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: #555;
    border-top: 1px solid #999; border-bottom: 1px solid #999; padding: 4px 2px; margin-top: 10px;
  }
  .archive-nav input[type="date"] {
    font-family: Arial, sans-serif; font-size: 11px; color: #555; border: 1px solid #999;
    background: #fdfcf7; padding: 1px 4px; letter-spacing: normal; text-transform: none;
  }
  /* Both columns are flex stacks so a reader preference can reorder them with
     CSS `order` alone — no rebuild, no second page, and if JavaScript never
     runs the document order below is what everyone sees. */
  .main-col, .side-col { display: flex; flex-direction: column; }
  .featured { order: 0; }   /* always first, whoever is reading */
  .politics { order: 1; } .apu-corner-section { order: 2; }
  .geo { order: 3; } .sports { order: 4; } .showcase { order: 9; }
  .tech-desk { order: 1; } .science-desk { order: 2; }
  .philosophy-desk { order: 3; } .entertainment { order: 4; }
  /* Apu reads India first, and science before the technology desk. */
  body[data-reader="apu"] .apu-corner-section { order: 1; }
  body[data-reader="apu"] .politics { order: 2; }
  body[data-reader="apu"] .science-desk { order: 1; }
  body[data-reader="apu"] .tech-desk { order: 2; }
  .reader-pick button { font-family: Arial, sans-serif; font-size: 11px; letter-spacing: .5px;
    text-transform: uppercase; color: #555; background: none; border: 1px solid #bbb;
    padding: 1px 6px; margin-left: 3px; cursor: pointer; }
  .reader-pick button[aria-pressed="true"] { background: #1a1a1a; color: #fdfcf7; border-color: #1a1a1a; }
  .page { display: grid; grid-template-columns: 1.7fr 1fr; gap: 0; }
  @media (max-width: 900px) { .page { grid-template-columns: 1fr; } }
  .main-col { padding-right: 28px; border-right: 3px double #1a1a1a; }
  @media (max-width: 900px) { .main-col { border-right: none; padding-right: 0; } }
  .side-col { padding-left: 28px; }
  @media (max-width: 900px) { .side-col { padding-left: 0; margin-top: 20px; } }
  section { margin-bottom: 26px; padding-bottom: 18px; border-bottom: 1px solid #ccc; }
  h2 {
    font-size: 19px; font-weight: bold; text-transform: uppercase; letter-spacing: 1.8px;
    border-top: 3px solid #1a1a1a; border-bottom: 1px solid #1a1a1a; padding: 5px 0; margin: 0 0 12px;
  }
  .tag { font-family: Arial, sans-serif; font-weight: normal; text-transform: none; letter-spacing: 0; font-size: 11px; color: #888; }
  /* One flowing container per section. The browser measures the content and
     evens the two columns itself, so a section can gain or lose stories and
     still come out level. Replaces two fixed lists that could never balance. */
  .flow { columns: 2; column-gap: 22px; column-rule: 1px solid #ccc; }
  .flow > div { break-inside: avoid; -webkit-column-break-inside: avoid; }
  @media (max-width: 900px) { .flow { columns: 1; column-rule: none; } }
  /* The day's lead story spans the full width above the flow. */
  .lede { column-span: all; padding-bottom: 14px; margin-bottom: 16px;
          border-bottom: 2px solid #1a1a1a; }
  .lede h3 { font-size: 25px !important; line-height: 1.18; }
  .lede .blurb { font-size: 14px; }
  .single { display: block; }
  .top-item { margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px dotted #ccc; }
  .top-item:last-child { border-bottom: none; }
  .top-item h3 { margin: 0 0 3px; font-size: 17px; line-height: 1.25; text-wrap: pretty; }
  .top-item h3 a { color: #1a1a1a; text-decoration: none; }
  .top-item h3 a:hover { text-decoration: underline; }
  .source { font-family: Arial, sans-serif; font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.5px; font-weight: bold; color: #a08030; }
  .blurb { margin: 4px 0 0; font-size: 13.5px; color: #333; line-height: 1.5; }
  .pm-note { margin: 5px 0 0; font-size: 12.5px; color: #444; font-style: italic; }
  .pm-note b { font-style: normal; color: #1a1a1a; }
  .more-item { margin-bottom: 11px; padding-bottom: 10px; border-bottom: 1px dotted #ddd; display: flex; gap: 8px; align-items: flex-start; }
  .more-item img { width: 56px; height: auto; max-height: 78px; border-radius: 3px; flex-shrink: 0; display: block; }
  .more-item h4 { margin: 0; font-size: 13.5px; line-height: 1.3; text-wrap: pretty; }
  .more-item h4 a { color: #1a1a1a; text-decoration: none; }
  .more-item h4 a:hover { text-decoration: underline; }
  .more-item .source { font-size: 9.5px; }
  .more-item p { margin: 3px 0 0; font-size: 12px; color: #555; }
  .investigative-flag { display: inline-block; font-family: Arial, sans-serif; font-size: 8.5px; font-weight: bold; letter-spacing: 0.5px; text-transform: uppercase; color: #fff; background: #7a1f0f; padding: 1px 5px; border-radius: 2px; margin-left: 6px; vertical-align: middle; }
  .politics h2, .politics .source { color: #7a1f0f; border-color: #7a1f0f; }
  .apu-corner-section h2, .apu-corner-section .source { color: #9c3d5c; border-color: #9c3d5c; }
  .geo h2, .geo .source { color: #12345c; border-color: #12345c; }
  .sports h2, .sports .source { color: #8a5a00; border-color: #8a5a00; }
  .entertainment h2, .entertainment .source { color: #7a2a5c; border-color: #7a2a5c; }
  .side-col .tech-masthead { text-align: center; font-family: Arial, sans-serif; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: #2b4a52; font-weight: bold; margin-bottom: 6px; }
  .tech h2 { color: #2b4a52; border-color: #2b4a52; font-size: 21px; }
  .tech .source { color: #2b4a52; }
  .tech .top-item h3 { font-size: 18px; }
  .side-col .science h2, .side-col .science .source { color: #1f5f5b; border-color: #1f5f5b; font-size: 19px; }
  .side-col .science .top-item h3 { font-size: 16px; }
  .side-col .consciousness h2, .side-col .consciousness .source { color: #4a2470; border-color: #4a2470; font-size: 19px; }
  .side-col .consciousness .top-item h3 { font-size: 16px; }
  .side-col .entertainment h2 { font-size: 19px; }
  .side-col .entertainment .top-item h3 { font-size: 16px; }
  .primer-box { background: #eef3f2; border: 1px solid #2b4a52; padding: 14px 16px; margin-top: 8px; }
  .primer-box h5 { margin: 0 0 8px; font-family: Arial, sans-serif; font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; color: #2b4a52; }
  .primer-item { margin-bottom: 10px; }
  .primer-item:last-child { margin-bottom: 0; }
  .primer-item .term { font-weight: bold; font-size: 14px; }
  .primer-item p { margin: 2px 0 0; font-size: 12.5px; color: #444; line-height: 1.45; }
  .apu-sub { font-family: Arial, sans-serif; font-size: 9.5px; letter-spacing: 1px; text-transform: uppercase; color: #9c3d5c; font-weight: bold; margin: 10px 0 5px; }
  .apu-corner { column-span: all; margin-top: 14px; padding-top: 12px; border-top: 1px dashed #9c3d5c;
                display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; align-items: start; }
  @media (max-width: 900px) { .apu-corner { grid-template-columns: 1fr; } }
  .apu-sub:first-child { margin-top: 0; }
  .apu-item { display: flex; gap: 8px; margin-bottom: 10px; align-items: flex-start; }
  .apu-item img { width: 56px; height: auto; max-height: 78px; border-radius: 3px; flex-shrink: 0; display: block; }
  .apu-item .apu-text h4 { margin: 0; font-size: 12.5px; line-height: 1.3; }
  .apu-item .apu-text h4 a { color: #1a1a1a; text-decoration: none; }
  .apu-item .apu-text p { margin: 3px 0 0; font-size: 11.5px; color: #555; }
  .apu-happy { background: #fdf6f9; border: 1px dashed #9c3d5c; padding: 8px 10px; border-radius: 4px; }
  /* Photographs are sized by WIDTH ONLY, height:auto — their real aspect ratio
     is preserved whatever it is (3:2, 4:3, 1:1, portrait). Never object-fit:
     cover with a fixed height: that crops the subject out of the frame. */
  .featured h2 { color: #4a5d3a; border-color: #4a5d3a; }
  .featured .tag { color: #6b6157; }
  /* Photo and its note sit side by side, so there is no reserved-but-empty space.
     With nothing written about the frame yet, .bare lets the picture take the
     full column instead of leaving a hole where text would have gone. */
  .featured-body { display: grid; grid-template-columns: 1.5fr 1fr; gap: 20px; align-items: start; }
  .featured-body.bare { grid-template-columns: 1fr; }
  @media (max-width: 700px) { .featured-body { grid-template-columns: 1fr; } }
  .frame-block { margin: 0; }
  .frame-block img { width: 100%; height: auto; display: block; border: 1px solid #e0dcd2; }
  .featured-body.bare .frame-block.portrait img { max-width: 320px; }
  .featured-text h3 { font-size: 18px; line-height: 1.25; margin: 0 0 3px; }
  .featured-meta { font-family: Arial, sans-serif; font-size: 10px; letter-spacing: 1px;
    text-transform: uppercase; color: #4a5d3a; margin: 0 0 9px; font-weight: bold; }
  .featured-note { font-size: 13.5px; color: #333; line-height: 1.5; margin: 0; }
  .featured-research { font-size: 13px; color: #444; line-height: 1.5; margin: 9px 0 0;
    padding-left: 10px; border-left: 2px solid #4a5d3a; }
  /* Camera settings on one line, the way a photographer writes them. */
  .exif { font-family: Arial, sans-serif; font-size: 10px; letter-spacing: .4px;
    color: #6b6157; margin: 11px 0 0; padding-top: 9px; border-top: 1px solid #e0dcd2;
    font-variant-numeric: tabular-nums; line-height: 1.45; }
  /* The describe control is an authoring aid, not something Apu needs to see. */
  #flick-fill { display: none; background: none; border: 1px solid #bbb; cursor: pointer;
    font-family: Arial, sans-serif; font-size: 9.5px; letter-spacing: .5px;
    text-transform: uppercase; color: #6b6157; padding: 1px 6px; margin-left: 6px; }
  #flick-fill:hover { border-color: #4a5d3a; color: #4a5d3a; }
  body[data-reader="ganges"] #flick-fill { display: inline-block; }
  #flick-modal { position: fixed; inset: 0; z-index: 50; background: rgba(26,26,26,.4);
    display: flex; align-items: center; justify-content: center; padding: 20px; }
  #flick-modal[hidden] { display: none; }
  .flick-card { background: #fdfcf7; border: 3px double #1a1a1a; max-width: 520px; width: 100%;
    max-height: 88vh; overflow-y: auto; padding: 22px 24px; }
  .flick-card h2 { font-size: 19px; text-transform: uppercase; letter-spacing: 1.8px;
    border: none; padding: 0; margin: 0 0 6px; }
  .flick-lede { font-size: 12.5px; color: #6b6157; line-height: 1.5; margin: 0 0 16px; }
  .flick-lede code { font-family: ui-monospace, Menlo, monospace; font-size: 11.5px;
    background: #efece2; padding: 1px 4px; }
  .flick-card label { display: block; font-family: Arial, sans-serif; font-size: 10px;
    letter-spacing: 1px; text-transform: uppercase; color: #6b6157; margin-bottom: 12px; }
  .flick-card input, .flick-card textarea { display: block; width: 100%; margin-top: 4px;
    font-family: Georgia, serif; font-size: 14px; color: #1a1a1a; background: #fff;
    border: 1px solid #bbb; padding: 6px 8px; text-transform: none; letter-spacing: normal; }
  .flick-card textarea { resize: vertical; line-height: 1.45; }
  #flick-json { font-family: ui-monospace, Menlo, monospace; font-size: 11px; line-height: 1.45;
    background: #efece2; border: 1px solid #ddd7cb; padding: 10px; overflow-x: auto;
    white-space: pre; margin: 0 0 14px; max-height: 190px; }
  .flick-actions { display: flex; gap: 8px; }
  .flick-actions button { font-family: Arial, sans-serif; font-size: 11px; letter-spacing: .5px;
    text-transform: uppercase; padding: 6px 12px; border: 1px solid #1a1a1a;
    background: none; cursor: pointer; color: #1a1a1a; }
  #flick-copy, #flick-save { background: #1a1a1a; color: #fdfcf7; }
  .flick-actions button[hidden] { display: none; }
  .flick-status { font-family: Arial, sans-serif; font-size: 11.5px; color: #4a5d3a;
    margin: 10px 0 0; min-height: 1em; }
  .flick-status.bad { color: #7a1f0f; }
  #flick-json[hidden] { display: none; }
  @media print { #flick-modal, #flick-fill { display: none !important; } }
  .featured-by { font-family: Arial, sans-serif; font-size: 9.5px; letter-spacing: .8px;
    text-transform: uppercase; color: #6b6157; margin: 10px 0 0; }
  .featured-by a { color: #4a5d3a; text-decoration: none; }
  .featured-by a:hover { text-decoration: underline; }
  .section-photo { margin: 0 0 14px; break-inside: avoid; }
  .section-photo img { width: 100%; height: auto; display: block; border: 1px solid #e0dcd2; }
  .section-photo.portrait img { max-width: 74%; margin: 0 auto; }
  .section-photo figcaption, .showcase figcaption { font-family: Arial, sans-serif; font-size: 9.5px;
    letter-spacing: 1px; text-transform: uppercase; color: #4a5d3a; font-weight: bold; margin-top: 5px; }
  .section-photo figcaption span, .showcase figcaption span { color: #6b6157; font-weight: normal; }
  /* Everything past the fold. Native <details> — no JavaScript, so archived
     editions keep working forever. */
  details.fold { margin-top: 10px; }
  details.fold > summary { font-family: Arial, sans-serif; font-size: 11px; letter-spacing: 1px;
    text-transform: uppercase; font-weight: bold; color: #6b6157; cursor: pointer;
    padding: 6px 0; border-top: 1px solid #ccc; list-style: none; }
  details.fold > summary::-webkit-details-marker { display: none; }
  details.fold > summary::after { content: " \002B"; font-size: 13px; }
  details.fold[open] > summary::after { content: " \2212"; }
  details.fold > summary:hover { color: #1a1a1a; }
  details.fold > .flow { padding-top: 10px; }
  /* ---- Saving stories ------------------------------------------------ */
  .source-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
  .source-row .source { min-width: 0; }
  button.save { flex-shrink: 0; background: none; border: none; padding: 0 0 0 6px; margin: -1px 0 0;
    cursor: pointer; color: #bdb6a8; line-height: 1; }
  button.save:hover { color: #7a1f0f; }
  button.save[aria-pressed="true"] { color: #7a1f0f; }
  button.save[aria-pressed="true"] svg path { fill: #7a1f0f; }
  button.save:focus-visible, .saved-open-wrap button:focus-visible,
  #saved-panel button:focus-visible { outline: 2px solid #7a1f0f; outline-offset: 2px; }
  .saved-open-wrap button { font-family: Arial, sans-serif; font-size: 11px; letter-spacing: .5px;
    text-transform: uppercase; color: #555; background: none; border: 1px solid #bbb;
    padding: 1px 7px; cursor: pointer; display: inline-flex; align-items: center; gap: 5px; }
  .saved-open-wrap button:hover { border-color: #1a1a1a; color: #1a1a1a; }
  #saved-count { font-weight: bold; }

  /* The browser's own [hidden] rule is `display: none` at the weakest possible
     specificity, so an ID selector setting `display: flex` silently beats it and
     the panel is stuck open. These two rules re-assert hiding at ID+attribute
     specificity. This is why the panel appeared on load and would not close. */
  #saved-panel[hidden], #saved-backdrop[hidden] { display: none; }
  #saved-backdrop { position: fixed; inset: 0; background: rgba(26,26,26,.35); z-index: 40; }
  #saved-panel { position: fixed; top: 0; right: 0; bottom: 0; width: min(400px, 92vw);
    background: #fdfcf7; border-left: 3px double #1a1a1a; z-index: 41;
    display: flex; flex-direction: column; box-shadow: -6px 0 24px rgba(26,26,26,.12); }
  .saved-head { display: flex; align-items: center; justify-content: space-between;
    padding: 18px 20px 10px; border-bottom: 1px solid #ccc; }
  .saved-head h2 { font-size: 19px; font-weight: bold; text-transform: uppercase;
    letter-spacing: 1.8px; margin: 0; border: none; padding: 0; }
  #saved-close { background: none; border: none; font-size: 26px; line-height: 1;
    color: #6b6157; cursor: pointer; padding: 0 2px; }
  .saved-who { font-family: Arial, sans-serif; font-size: 10.5px; letter-spacing: .8px;
    text-transform: uppercase; color: #6b6157; margin: 0; padding: 10px 20px 0; }
  #saved-list { flex: 1; overflow-y: auto; padding: 12px 20px 20px; }
  .saved-item { display: flex; gap: 10px; align-items: flex-start;
    padding-bottom: 12px; margin-bottom: 12px; border-bottom: 1px dotted #ccc; }
  .saved-item:last-child { border-bottom: none; }
  .saved-item .meta { font-family: Arial, sans-serif; font-size: 9.5px; letter-spacing: .5px;
    text-transform: uppercase; color: #6b6157; }
  .saved-item h3 { font-size: 15px; line-height: 1.3; margin: 3px 0 0; font-weight: normal; }
  .saved-item h3 a { color: #1a1a1a; text-decoration: none; }
  .saved-item h3 a:hover { text-decoration: underline; }
  .saved-item button { flex-shrink: 0; background: none; border: none; cursor: pointer;
    color: #a89f92; font-size: 17px; line-height: 1; padding: 2px; }
  .saved-item button:hover { color: #7a1f0f; }
  .saved-empty { font-size: 13.5px; color: #6b6157; font-style: italic; line-height: 1.5; }
  .saved-foot { border-top: 1px solid #ccc; padding: 12px 20px; }
  #saved-export { font-family: Arial, sans-serif; font-size: 11px; letter-spacing: .5px;
    text-transform: uppercase; color: #555; background: none; border: 1px solid #bbb;
    padding: 4px 10px; cursor: pointer; }
  #saved-export:hover { border-color: #1a1a1a; color: #1a1a1a; }
  #saved-toast { position: fixed; left: 50%; bottom: 26px; transform: translateX(-50%);
    background: #1a1a1a; color: #fdfcf7; font-family: Arial, sans-serif; font-size: 12.5px;
    padding: 9px 16px; border-radius: 3px; z-index: 60; max-width: 88vw; text-align: center; }
  @media print { .saved-open-wrap, button.save, #saved-panel, #saved-backdrop { display: none !important; } }
  .showcase h2 { color: #4a5d3a; border-color: #4a5d3a; }
  .showcase .tag { color: #6b6157; }
  .showcase .frames { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; align-items: start; }
  @media (max-width: 700px) { .showcase .frames { grid-template-columns: 1fr 1fr; } }
  .showcase .frames a { display: block; }
  .showcase .frames img { width: 100%; height: auto; display: block; border: 1px solid #e0dcd2; }
  @media (max-width: 700px) { .showcase .frames a:first-child { grid-column: 1 / -1; } }
</style>
</head>
<body>
<header>
  <img class="header-logo" src="{{ icon_prefix }}icons/icon-192.png" alt="Grumpy Iyer logo">
  <h1 class="masthead">The Aperture</h1>
  <div class="dateline-row">
    <span>{{ date_long }}</span>
    <span class="saved-open-wrap"><button type="button" id="saved-open" aria-expanded="false" aria-controls="saved-panel">
      <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3.5 1.5h9v13l-4.5-3.5-4.5 3.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
      Read Later <span id="saved-count">0</span></button></span>
    <span class="reader-pick">Reading order:
      <button type="button" data-reader-set="ganges">Ganges</button>
      <button type="button" data-reader-set="apu">Apu</button>
    </span>
    <span class="archive-nav">Browse editions: <input type="date" id="archive-date" min="{{ archive_min }}" max="{{ date }}" value="{{ date }}" onchange="if(this.value) location.href = '{{ archive_prefix }}' + this.value + '.html'"></span>
  </div>
</header>
<div class="page">
  <div class="main-col">
{%- if showcase %}
{%- set pic = showcase[0] %}
{%- set has_text = pic.note or pic.subject or pic.research %}
    <section class="featured">
      <h2>Featured Flick <span class="tag">from the archive</span></h2>
      <div class="featured-body{% if not has_text %} bare{% endif %}">
        <figure class="frame-block{% if pic.portrait %} portrait{% endif %}">
          <a href="https://grumpyiyer.com" target="_blank" rel="noopener">
            <img src="{{ icon_prefix }}wildlife/{{ pic.file }}" width="{{ pic.w }}" height="{{ pic.h }}"
                 alt="{% if pic.subject %}{{ pic.subject }}{% else %}Wildlife photograph{% endif %}, photographed by Ganges Bhardwaj">
          </a>
        </figure>
        <div class="featured-text">
          {%- if pic.subject %}
          <h3>{{ pic.subject }}</h3>
          {%- endif %}
          {%- if pic.where or pic.year %}
          <p class="featured-meta">{{ pic.where }}{% if pic.where and pic.year %} · {% endif %}{{ pic.year }}</p>
          {%- endif %}
          {%- if pic.note %}
          <p class="featured-note">{{ pic.note }}</p>
          {%- endif %}
          {%- if pic.research %}
          <p class="featured-research">{{ pic.research }}</p>
          {%- endif %}
          {%- if pic.iso or pic.aperture or pic.shutter or pic.focal %}
          <p class="exif">{% set bits = [] %}
            {%- if pic.camera %}{% set _ = bits.append(pic.camera) %}{% endif %}
            {%- if pic.focal %}{% set _ = bits.append(pic.focal) %}{% endif %}
            {%- if pic.aperture %}{% set _ = bits.append(pic.aperture) %}{% endif %}
            {%- if pic.shutter %}{% set _ = bits.append(pic.shutter) %}{% endif %}
            {%- if pic.iso %}{% set _ = bits.append('ISO ' ~ pic.iso) %}{% endif %}
            {{- bits|join(' · ') }}</p>
          {%- endif %}
          <p class="featured-by">Photograph by <a href="https://grumpyiyer.com" target="_blank" rel="noopener">Ganges Bhardwaj</a>{% if pic.taken %} · {{ pic.taken }}{% endif %}
            <button type="button" id="flick-fill" data-file="{{ pic.file }}"
              data-subject="{{ pic.subject }}" data-where="{{ pic.where }}"
              data-note="{{ pic.note }}" data-research="{{ pic.research }}"
              aria-label="Describe this photograph">&#9998; Describe</button></p>
        </div>
      </div>
    </section>
{%- endif %}
{{- section_std('politics', 'US Politics', none, s.politics.top, s.politics.more, lede.politics) }}
    <section class="apu-corner-section">
      <h2>Apu's Corner</h2>
      <div class="apu-sub">India</div>
      <div class="flow">
        {%- if s.india.top %}
{{- item_top(s.india.top[0], true, 'India') }}
        {%- for it in s.india.top[1:] %}{{ item_top(it, false, 'India') }}{% endfor %}
        {%- endif %}
        {%- for it in s.india.more %}{{ item_more(it, 'India') }}{% endfor %}
        <div class="apu-corner">
          <div>
            {%- if s.bengal %}
            <div class="apu-sub">Bengal</div>
            {%- for it in s.bengal %}{{ item_apu(it, 'Bengal') }}{% endfor %}
            {%- endif %}
          </div>
          <div>
            {%- if s.travel %}
            <div class="apu-sub">Travel</div>
            {%- for it in s.travel %}{{ item_apu(it, 'Travel') }}{% endfor %}
            {%- endif %}
          </div>
          <div>
            {%- if s.happy %}
            <div class="apu-sub">A Happy Story <span class="tag">for no reason at all</span></div>
            <div class="apu-happy">
            {{- item_apu(s.happy, 'A Happy Story') }}
            </div>
            {%- endif %}
          </div>
        </div>
      </div>
    </section>
{{- section_std('geo', 'Geopolitics', none, s.geo.top, s.geo.more, lede.geo) }}
{{- section_std('sports', 'Cricket', none, s.sports.top, s.sports.more, lede.sports) }}
{%- if showcase[1:] %}{{ showcase_section(showcase[1:]) }}{% endif %}
  </div>
  <div class="side-col">
    <div class="desk tech-desk">
    <div class="tech-masthead">— Technology Desk —</div>
    <section class="tech">
      <h2>Top Tech</h2>
      {%- for it in s.tech_top %}{{ item_top(it, false, 'Top Tech') }}{% endfor %}
    </section>
    <section class="tech">
      <h2>More Tech</h2>
      {%- for it in s.tech_more %}{{ item_more(it, 'More Tech') }}{% endfor %}
    </section>
    <section class="tech">
      <h2>Tech 101 <span class="tag">for newbies</span></h2>
{{- primer_box(s.tech_101) }}
    </section>
    </div>
    <div class="desk science-desk">
    {%- if s.science %}
    <section class="science">
      <h2>Science</h2>
      {%- for it in s.science %}{{ item_top(it, false, 'Science') }}{% endfor %}
    </section>
    {%- endif %}
    </div>
    <div class="desk philosophy-desk">
    <section class="consciousness">
      <h2>Philosophy</h2>
      {%- for it in s.philosophy %}{{ item_top(it, false, 'Philosophy') }}{% endfor %}
    </section>
    <section class="consciousness">
      <h2>Philosophy 101 <span class="tag">for newbies</span></h2>
{{- primer_box(s.philosophy_101) }}
    </section>
    </div>
    {#- Entertainment moved here from the main column: rendered flat (no flow,
        no lede) like the tech sections, to fill the side column's tail. -#}
    <section class="entertainment" style="border-bottom: none;">
      <h2>Entertainment &amp; Culture</h2>
      {%- for it in s.entertainment.top %}{{ item_top(it, false, 'Entertainment') }}{% endfor %}
      {%- for it in s.entertainment.more %}{{ item_more(it, 'Entertainment') }}{% endfor %}
    </section>
  </div>
</div>

<div id="saved-backdrop" hidden></div>

<div id="flick-modal" role="dialog" aria-modal="true" aria-labelledby="flick-modal-title" hidden>
  <div class="flick-card">
    <h2 id="flick-modal-title">Describe this photograph</h2>
    <p class="flick-lede" id="flick-mode">Your words about the frame. Camera settings are read from the file itself.</p>
    <label>Subject <input type="text" id="flick-subject" placeholder="Bald eagle"></label>
    <label>Where <input type="text" id="flick-where" placeholder="Cohoes Falls, New York"></label>
    <label>Your note <textarea id="flick-note" rows="3" placeholder="What the light was doing. How long you waited. Why you kept this one."></textarea></label>
    <label>Research <textarea id="flick-research" rows="3" placeholder="Left blank — tell Claude the subject and it will draft this with a source."></textarea></label>
    <pre id="flick-json" aria-live="polite"></pre>
    <div class="flick-actions">
      <button type="button" id="flick-save" hidden>Save</button>
      <button type="button" id="flick-copy" hidden>Copy for photos.json</button>
      <button type="button" id="flick-cancel">Close</button>
    </div>
    <p class="flick-status" id="flick-status" role="status"></p>
  </div>
</div>
<aside id="saved-panel" aria-labelledby="saved-title" aria-hidden="true" hidden>
  <div class="saved-head">
    <h2 id="saved-title">Read Later</h2>
    <button type="button" id="saved-close" aria-label="Close read later">&times;</button>
  </div>
  <p class="saved-who">Kept by <strong id="saved-reader">Ganges</strong> · <span id="saved-usage">0 of 10</span></p>
  <div id="saved-list"></div>
  <div class="saved-foot">
    <button type="button" id="saved-export">Export as a file</button>
  </div>
</aside>

<script>
// Reader preference. Purely presentational: it sets one attribute and CSS does
// the reordering. Stored per browser — wrapped in try/catch because private
// windows and blocked site-data make localStorage throw rather than return null.
(function () {
  var KEY = "aperture-reader";
  function apply(who) {
    document.body.setAttribute("data-reader", who);
    document.querySelectorAll("[data-reader-set]").forEach(function (b) {
      b.setAttribute("aria-pressed", b.dataset.readerSet === who ? "true" : "false");
    });
  }
  var saved = "ganges";
  try { saved = localStorage.getItem(KEY) || "ganges"; } catch (e) {}
  apply(saved);
  document.querySelectorAll("[data-reader-set]").forEach(function (b) {
    b.addEventListener("click", function () {
      var who = b.dataset.readerSet;
      try { localStorage.setItem(KEY, who); } catch (e) {}
      apply(who);
    });
  });
})();

// ---- Read later -----------------------------------------------------------
// Saves live in this browser only (see decisions/001-bookmark-storage.md).
// Every entry carries savedAt: the field is unused today, and is what a future
// sync will need to settle two devices disagreeing. Adding it now costs nothing.
(function () {
  var KEY = "aperture-saves", CAP = 10, EDITION = "{{ date }}";
  var NAMES = { ganges: "Ganges", apu: "Apu" };

  function reader() { return document.body.getAttribute("data-reader") || "ganges"; }
  function readAll() {
    try { return JSON.parse(localStorage.getItem(KEY) || "{}") || {}; } catch (e) { return {}; }
  }
  function writeAll(all) {
    try { localStorage.setItem(KEY, JSON.stringify(all)); return true; }
    catch (e) { toast("This browser will not let the page save anything."); return false; }
  }
  function mine() { var a = readAll()[reader()]; return Array.isArray(a) ? a : []; }
  function setMine(list) { var all = readAll(); all[reader()] = list; return writeAll(all); }

  var toastTimer;
  function toast(msg) {
    var el = document.getElementById("saved-toast");
    if (!el) { el = document.createElement("div"); el.id = "saved-toast"; document.body.appendChild(el); }
    el.textContent = msg;
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { el.remove(); }, 3600);
  }

  function paintButtons() {
    var saved = {};
    mine().forEach(function (s) { saved[s.url] = true; });
    document.querySelectorAll("button.save").forEach(function (b) {
      var on = !!saved[b.dataset.url];
      b.setAttribute("aria-pressed", on ? "true" : "false");
      b.setAttribute("aria-label", (on ? "Remove this story from" : "Add this story to") + " read later");
    });
    var list = mine();
    document.getElementById("saved-count").textContent = list.length;
    var usage = document.getElementById("saved-usage");
    if (usage) usage.textContent = list.length + " of " + CAP;
    var who = document.getElementById("saved-reader");
    if (who) who.textContent = NAMES[reader()] || reader();
  }

  function paintPanel() {
    var box = document.getElementById("saved-list"), list = mine();
    box.textContent = "";
    if (!list.length) {
      var p = document.createElement("p");
      p.className = "saved-empty";
      p.textContent = "Nothing here yet. The bookmark beside any story adds it to read later — up to " + CAP + " at a time.";
      box.appendChild(p);
      return;
    }
    list.forEach(function (s) {
      var row = document.createElement("div");
      row.className = "saved-item";
      var text = document.createElement("div");
      var meta = document.createElement("div");
      meta.className = "meta";
      meta.textContent = s.source + (s.section ? " · " + s.section : "") + " · " + s.edition;
      var h = document.createElement("h3");
      var a = document.createElement("a");
      a.href = s.url; a.target = "_blank"; a.rel = "noopener"; a.textContent = s.headline;
      h.appendChild(a);
      text.appendChild(meta); text.appendChild(h);
      var rm = document.createElement("button");
      rm.type = "button"; rm.innerHTML = "&times;";
      rm.setAttribute("aria-label", "Remove " + s.headline);
      rm.addEventListener("click", function () {
        setMine(mine().filter(function (x) { return x.url !== s.url; }));
        paintButtons(); paintPanel();
      });
      row.appendChild(text); row.appendChild(rm);
      box.appendChild(row);
    });
  }

  document.querySelectorAll("button.save").forEach(function (b) {
    b.addEventListener("click", function () {
      var list = mine(), url = b.dataset.url;
      if (list.some(function (x) { return x.url === url; })) {
        setMine(list.filter(function (x) { return x.url !== url; }));
      } else {
        if (list.length >= CAP) {
          toast("Read later is full at " + CAP + ". Remove one to make room.");
          return;
        }
        list.unshift({ url: url, headline: b.dataset.headline, source: b.dataset.source,
                       section: b.dataset.section, edition: EDITION,
                       savedAt: new Date().toISOString() });
        setMine(list);
      }
      paintButtons(); paintPanel();
    });
  });

  var panel = document.getElementById("saved-panel"),
      backdrop = document.getElementById("saved-backdrop"),
      opener = document.getElementById("saved-open");
  function open() {
    paintPanel();
    panel.hidden = false; backdrop.hidden = false;
    panel.setAttribute("aria-hidden", "false");
    opener.setAttribute("aria-expanded", "true");
    document.getElementById("saved-close").focus();
  }
  function close() {
    panel.hidden = true; backdrop.hidden = true;
    panel.setAttribute("aria-hidden", "true");
    opener.setAttribute("aria-expanded", "false");
    opener.focus();
  }
  opener.addEventListener("click", function () { panel.hidden ? open() : close(); });
  document.getElementById("saved-close").addEventListener("click", close);
  backdrop.addEventListener("click", close);
  document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !panel.hidden) close(); });

  document.getElementById("saved-export").addEventListener("click", function () {
    var blob = new Blob([JSON.stringify(mine(), null, 2)], { type: "application/json" });
    var a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "aperture-read-later-" + reader() + ".json";
    a.click();
    setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
  });

  // Switching reader switches whose list is shown — the toggle is the identity.
  document.querySelectorAll("[data-reader-set]").forEach(function (b) {
    b.addEventListener("click", function () {
      paintButtons();
      if (!panel.hidden) paintPanel();
    });
  });

  paintButtons();
})();

// ---- Describe this photograph --------------------------------------------
// The same form behaves differently depending on how the page is being served.
// Published, it is static files and nothing can write to the repo, so it offers
// the entry to copy. Run under edit_photos.py on localhost, a small local
// helper is listening and Save writes photos.json and rebuilds for real.
(function () {
  var fill = document.getElementById("flick-fill");
  if (!fill) return;
  var modal = document.getElementById("flick-modal"),
      out = document.getElementById("flick-json"),
      status = document.getElementById("flick-status"),
      mode = document.getElementById("flick-mode"),
      saveBtn = document.getElementById("flick-save"),
      copyBtn = document.getElementById("flick-copy"),
      f = {
        subject: document.getElementById("flick-subject"),
        where: document.getElementById("flick-where"),
        note: document.getElementById("flick-note"),
        research: document.getElementById("flick-research")
      };

  var host = location.hostname;
  var canSave = (host === "localhost" || host === "127.0.0.1");

  if (canSave) {
    saveBtn.hidden = false;
    out.hidden = true;
    mode.textContent = "Your words about the frame. Saving writes photos.json and rebuilds the page.";
  } else {
    copyBtn.hidden = false;
    mode.textContent = "Your words about the frame. This published page cannot write files, " +
      "so copy the entry into photos.json. To save directly, view the site with  python3 preview.py";
  }

  function values() {
    var v = {};
    Object.keys(f).forEach(function (k) { v[k] = f[k].value.trim(); });
    return v;
  }
  function compose() {
    var body = {};
    body[fill.dataset.file] = values();
    out.textContent = JSON.stringify(body, null, 2);
  }
  function say(msg, bad) {
    status.textContent = msg;
    status.className = "flick-status" + (bad ? " bad" : "");
  }

  function open() {
    Object.keys(f).forEach(function (k) { f[k].value = fill.dataset[k] || ""; });
    compose(); say("");
    modal.hidden = false;
    f.subject.focus();
  }
  function close() { modal.hidden = true; fill.focus(); }

  fill.addEventListener("click", open);
  document.getElementById("flick-cancel").addEventListener("click", close);
  modal.addEventListener("click", function (e) { if (e.target === modal) close(); });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !modal.hidden) close(); });
  Object.keys(f).forEach(function (k) { f[k].addEventListener("input", compose); });

  saveBtn.addEventListener("click", function () {
    saveBtn.disabled = true; say("Saving…");
    fetch("/save-photo", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ file: fill.dataset.file, fields: values() })
    }).then(function (r) { return r.json(); }).then(function (res) {
      if (!res.saved) throw new Error(res.error || "save refused");
      say(res.rebuilt ? "Saved. Reloading…" : "Saved, but the rebuild failed — check the terminal.");
      if (res.rebuilt) setTimeout(function () { location.reload(); }, 700);
      else saveBtn.disabled = false;
    }).catch(function (e) {
      say("Could not save: " + e.message + ". Is preview.py still running?", true);
      saveBtn.disabled = false;
    });
  });

  copyBtn.addEventListener("click", function () {
    var btn = this, text = out.textContent;
    function done() { say("Copied — paste it into photos.json"); }
    if (navigator.clipboard) {
      navigator.clipboard.writeText(text).then(done, function () {
        var r = document.createRange(); r.selectNodeContents(out);
        var s = getSelection(); s.removeAllRanges(); s.addRange(r);
        say("Selected — press Cmd+C");
      });
    } else {
      var r = document.createRange(); r.selectNodeContents(out);
      var s = getSelection(); s.removeAllRanges(); s.addRange(r);
      say("Selected — press Cmd+C");
    }
  });
})();
</script>
</body>
</html>
