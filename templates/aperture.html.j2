{#- The Aperture — page template.
    Content comes from content/{date}.json. Layout/wording lives HERE only. -#}
{%- macro item_top(it, tight=false) %}
        <div class="top-item">
          <div class="source">{{ it.source }}{% if it.investigative %} <span class="investigative-flag">Investigative</span>{% endif %}</div>
          <h3><a href="{{ it.url }}" target="_blank">{{ it.headline }}</a></h3>
          <p class="blurb">{{ it.blurb }}</p>
          {%- if it.pm_note %}
          <p class="pm-note"><b>Why it matters for you:</b> {{ it.pm_note }}</p>
          {%- endif %}
        </div>
{%- endmacro %}
{%- macro item_more(it) %}
        <div class="more-item">
          {%- if it.image %}
          <img src="{{ it.image }}" alt="">
          {%- endif %}
          <div class="more-text">
            <div class="source">{{ it.source }}{% if it.investigative %} <span class="investigative-flag">Investigative</span>{% endif %}</div>
            <h4><a href="{{ it.url }}" target="_blank">{{ it.headline }}</a></h4>
            <p>{{ it.blurb }}</p>
          </div>
        </div>
{%- endmacro %}
{%- macro item_apu(it) %}
          <div class="apu-item">
            {%- if it.image %}
            <img src="{{ it.image }}" alt="">
            {%- endif %}
            <div class="apu-text">
              <div class="source">{{ it.source }}</div>
              <h4><a href="{{ it.url }}" target="_blank">{{ it.headline }}</a></h4>
              <p>{{ it.blurb }}</p>
            </div>
          </div>
{%- endmacro %}
{%- macro filler(name) %}
        <div class="wildlife-filler">
          <img src="{{ icon_prefix }}wildlife/{{ name }}" alt="">
          <div class="caption">From the archive</div>
        </div>
{%- endmacro %}
{%- macro primer_box(primers) %}
      <div class="primer-box">
        <h5>Today's Concept, Explained Simply</h5>
        {%- for p in primers %}
        <div class="primer-item">
          <div class="term">{{ p.term }}</div>
          <p>{{ p.text }}</p>
        </div>
        {%- endfor %}
      </div>
{%- endmacro %}
{#- A standard two-column main section. Collapses to one column when there are no more-items. -#}
{%- macro section_std(css, title, tag, top, more, fill) %}
    <section class="{{ css }}">
      <h2>{{ title }}{% if tag %} <span class="tag">{{ tag }}</span>{% endif %}</h2>
      <div class="cols">
        <div>
          {%- for it in top %}{{ item_top(it) }}{% endfor %}
        </div>
        {%- if more %}
        <div class="more-col">
          {%- for it in more %}{{ item_more(it) }}{% endfor %}
          {%- if fill %}{{ filler(fill) }}{% endif %}
        </div>
        {%- endif %}
      </div>
    </section>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>The Aperture — {{ date_long }}</title>
<style>
  body {
    font-family: 'Georgia', 'Times New Roman', serif;
    color: #1a1a1a;
    max-width: 1180px;
    margin: 0 auto;
    padding: 32px 24px;
    background: #fdfcf7;
  }
  header { text-align: center; border-bottom: 4px double #1a1a1a; padding-bottom: 14px; margin-bottom: 20px; position: relative; }
  .header-logo { position: absolute; top: 0; left: 0; width: 60px; height: 60px; object-fit: contain; }
  @media (max-width: 520px) { .header-logo { width: 40px; height: 40px; } }
  .masthead { font-size: 46px; font-weight: bold; letter-spacing: 1px; margin: 0; }
  .dateline-row {
    display: flex; justify-content: space-between; font-family: Arial, sans-serif;
    font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: #555;
    border-top: 1px solid #999; border-bottom: 1px solid #999; padding: 4px 2px; margin-top: 10px;
  }
  .archive-nav input[type="date"] {
    font-family: Arial, sans-serif; font-size: 11px; color: #555; border: 1px solid #999;
    background: #fdfcf7; padding: 1px 4px; letter-spacing: normal; text-transform: none;
  }
  .page { display: grid; grid-template-columns: 1.7fr 1fr; gap: 0; }
  @media (max-width: 900px) { .page { grid-template-columns: 1fr; } }
  .main-col { padding-right: 28px; border-right: 3px double #1a1a1a; }
  @media (max-width: 900px) { .main-col { border-right: none; padding-right: 0; } }
  .side-col { padding-left: 28px; }
  @media (max-width: 900px) { .side-col { padding-left: 0; margin-top: 20px; } }
  section { margin-bottom: 26px; padding-bottom: 18px; border-bottom: 1px solid #ccc; }
  h2 {
    font-size: 19px; font-weight: bold; text-transform: uppercase; letter-spacing: 1.8px;
    border-top: 3px solid #1a1a1a; border-bottom: 1px solid #1a1a1a; padding: 5px 0; margin: 0 0 12px;
  }
  .tag { font-family: Arial, sans-serif; font-weight: normal; text-transform: none; letter-spacing: 0; font-size: 11px; color: #888; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; align-items: start; }
  .cols:has(> :only-child) { grid-template-columns: 1fr; }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr; } }
  .single { display: block; }
  .top-item { margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px dotted #ccc; }
  .top-item:last-child { border-bottom: none; }
  .top-item h3 { margin: 0 0 3px; font-size: 17px; line-height: 1.25; }
  .top-item h3 a { color: #1a1a1a; text-decoration: none; }
  .top-item h3 a:hover { text-decoration: underline; }
  .source { font-family: Arial, sans-serif; font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.5px; font-weight: bold; color: #a08030; }
  .blurb { margin: 4px 0 0; font-size: 13.5px; color: #333; line-height: 1.5; }
  .pm-note { margin: 5px 0 0; font-size: 12.5px; color: #444; font-style: italic; }
  .pm-note b { font-style: normal; color: #1a1a1a; }
  .more-col { border-left: 2px solid #1a1a1a; padding-left: 18px; }
  .more-item { margin-bottom: 11px; display: flex; gap: 8px; align-items: flex-start; }
  .more-item img { width: 56px; height: auto; max-height: 78px; border-radius: 3px; flex-shrink: 0; display: block; }
  .more-item h4 { margin: 0; font-size: 13.5px; line-height: 1.3; }
  .more-item h4 a { color: #1a1a1a; text-decoration: none; }
  .more-item h4 a:hover { text-decoration: underline; }
  .more-item .source { font-size: 9.5px; }
  .more-item p { margin: 3px 0 0; font-size: 12px; color: #555; }
  .investigative-flag { display: inline-block; font-family: Arial, sans-serif; font-size: 8.5px; font-weight: bold; letter-spacing: 0.5px; text-transform: uppercase; color: #fff; background: #7a1f0f; padding: 1px 5px; border-radius: 2px; margin-left: 6px; vertical-align: middle; }
  .politics h2, .politics .source { color: #7a1f0f; border-color: #7a1f0f; }
  .apu-corner-section h2, .apu-corner-section .source { color: #9c3d5c; border-color: #9c3d5c; }
  .geo h2, .geo .source { color: #12345c; border-color: #12345c; }
  .sports h2, .sports .source { color: #8a5a00; border-color: #8a5a00; }
  .entertainment h2, .entertainment .source { color: #7a2a5c; border-color: #7a2a5c; }
  .side-col .tech-masthead { text-align: center; font-family: Arial, sans-serif; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: #2b4a52; font-weight: bold; margin-bottom: 6px; }
  .tech h2 { color: #2b4a52; border-color: #2b4a52; font-size: 21px; }
  .tech .source { color: #2b4a52; }
  .tech .top-item h3 { font-size: 18px; }
  .side-col .consciousness h2, .side-col .consciousness .source { color: #4a2470; border-color: #4a2470; font-size: 19px; }
  .side-col .consciousness .top-item h3 { font-size: 16px; }
  .primer-box { background: #eef3f2; border: 1px solid #2b4a52; padding: 14px 16px; margin-top: 8px; }
  .primer-box h5 { margin: 0 0 8px; font-family: Arial, sans-serif; font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; color: #2b4a52; }
  .primer-item { margin-bottom: 10px; }
  .primer-item:last-child { margin-bottom: 0; }
  .primer-item .term { font-weight: bold; font-size: 14px; }
  .primer-item p { margin: 2px 0 0; font-size: 12.5px; color: #444; line-height: 1.45; }
  .apu-sub { font-family: Arial, sans-serif; font-size: 9.5px; letter-spacing: 1px; text-transform: uppercase; color: #9c3d5c; font-weight: bold; margin: 10px 0 5px; }
  .apu-corner { margin-top: 14px; padding-top: 12px; border-top: 1px dashed #9c3d5c; }
  .apu-item { display: flex; gap: 8px; margin-bottom: 10px; align-items: flex-start; }
  .apu-item img { width: 56px; height: auto; max-height: 78px; border-radius: 3px; flex-shrink: 0; display: block; }
  .apu-item .apu-text h4 { margin: 0; font-size: 12.5px; line-height: 1.3; }
  .apu-item .apu-text h4 a { color: #1a1a1a; text-decoration: none; }
  .apu-item .apu-text p { margin: 3px 0 0; font-size: 11.5px; color: #555; }
  .apu-happy { background: #fdf6f9; border: 1px dashed #9c3d5c; padding: 8px 10px; border-radius: 4px; }
  .wildlife-filler { margin-top: 10px; text-align: center; }
  .wildlife-filler img { width: 100%; max-height: 110px; object-fit: cover; border-radius: 4px; display: block; }
  .wildlife-filler .caption { font-family: Arial, sans-serif; font-size: 9px; color: #999; margin-top: 3px; letter-spacing: 0.5px; text-transform: uppercase; }
</style>
</head>
<body>
<header>
  <img class="header-logo" src="{{ icon_prefix }}icons/icon-192.png" alt="Grumpy Iyer logo">
  <h1 class="masthead">The Aperture</h1>
  <div class="dateline-row">
    <span>{{ date_long }}</span>
    <span>Edifying Eddies</span>
    <span class="archive-nav">Browse editions: <input type="date" id="archive-date" min="{{ archive_min }}" max="{{ date }}" value="{{ date }}" onchange="if(this.value) location.href = '{{ archive_prefix }}' + this.value + '.html'"></span>
  </div>
</header>
<div class="page">
  <div class="main-col">
{{- section_std('politics', 'US Politics', none, s.politics.top, s.politics.more, fill.politics) }}
    <section class="apu-corner-section">
      <h2>Apu's Corner</h2>
      <div class="apu-sub">India</div>
      <div class="cols">
        <div>
          {%- for it in s.india.top %}{{ item_top(it) }}{% endfor %}
        </div>
        <div class="more-col">
          {%- for it in s.india.more %}{{ item_more(it) }}{% endfor %}
          <div class="apu-corner">
            {%- if s.bengal %}
            <div class="apu-sub">Bengal</div>
            {%- for it in s.bengal %}{{ item_apu(it) }}{% endfor %}
            {%- endif %}
            {%- if s.travel %}
            <div class="apu-sub">Travel</div>
            {%- for it in s.travel %}{{ item_apu(it) }}{% endfor %}
            {%- endif %}
            {%- if s.happy %}
            <div class="apu-sub">A Happy Story <span class="tag">for no reason at all</span></div>
            <div class="apu-happy">
            {{- item_apu(s.happy) }}
            </div>
            {%- endif %}
          </div>
          {%- if fill.apu %}{{ filler(fill.apu) }}{% endif %}
        </div>
      </div>
    </section>
{{- section_std('geo', 'Geopolitics', none, s.geo.top, s.geo.more, fill.geo) }}
{{- section_std('sports', 'Cricket', none, s.sports.top, s.sports.more, fill.sports) }}
{{- section_std('entertainment', 'Entertainment &amp; Culture', none, s.entertainment.top, s.entertainment.more, fill.entertainment) }}
  </div>
  <div class="side-col">
    <div class="tech-masthead">— Technology Desk —</div>
    <section class="tech">
      <h2>Top Tech</h2>
      {%- for it in s.tech_top %}{{ item_top(it) }}{% endfor %}
    </section>
    <section class="tech">
      <h2>More Tech</h2>
      {%- for it in s.tech_more %}{{ item_more(it) }}{% endfor %}
    </section>
    <section class="tech">
      <h2>Tech 101 <span class="tag">for newbies</span></h2>
{{- primer_box(s.tech_101) }}
    </section>
    <section class="consciousness">
      <h2>Philosophy &amp; Science</h2>
      {%- for it in s.philosophy %}{{ item_top(it) }}{% endfor %}
    </section>
    <section class="consciousness" style="border-bottom: none;">
      <h2>Philosophy 101 <span class="tag">for newbies</span></h2>
{{- primer_box(s.philosophy_101) }}
    </section>
  </div>
</div>
</body>
</html>
